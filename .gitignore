
# =====================================
# Python
# =====================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# =====================================
# Environment / Secrets
# =====================================
.env
.env.*

# =====================================
# Input Datasets
# Ignore all files and subfolders inside data/raw
/data/raw/*
!/data/raw/*/
!/data/raw/*/.gitkeep

# Ignore all processed datasets
/data/processed/*
!/data/processed/.gitkeep

# =====================================
# Elevation Datasets
# Keep elevation folder visible
/elevation/*
!/elevation/.gitkeep

# =====================================
# Trained Models
/ml/models/*
!/ml/models/.gitkeep

# =====================================
# IDE / Operating System
# =====================================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =====================================
# Logs and Temporary Files
# =====================================
*.log
*.tmp
